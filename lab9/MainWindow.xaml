<Window x:Class="lab9.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:lab9"
        Title="Квадратные уравнения" Height="620" Width="600"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">
            <!-- Ввод коэффициентов -->
            <GroupBox Header="Ввод коэффициентов (Уравнение 1)" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="a: " VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBox Grid.Column="1" Text="{Binding InputA, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,15,0" Padding="3"/>

                    <TextBlock Grid.Column="2" Text="b: " VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBox Grid.Column="3" Text="{Binding InputB, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,15,0" Padding="3"/>

                    <TextBlock Grid.Column="4" Text="c: " VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBox Grid.Column="5" Text="{Binding InputC, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" Padding="3"/>
                </Grid>
            </GroupBox>

            <!-- Основные результаты -->
            <GroupBox Header="Результаты анализа" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <TextBlock Text="Вид уравнения: " FontWeight="Bold"/>
                        <TextBlock Text="{Binding EquationText}" Foreground="Blue"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <TextBlock Text="Дискриминант (D): " FontWeight="Bold"/>
                        <TextBlock Text="{Binding DiscriminantText}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <TextBlock Text="Корни: " FontWeight="Bold"/>
                        <TextBlock Text="{Binding RootsText}" Foreground="Green"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Унарные операторы -->
            <GroupBox Header="Унарные операторы (++ / --)" Padding="10" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Увеличить коэффициенты (++eq)" Command="{Binding IncrementCommand}" Width="210" Height="30" Margin="5"/>
                    <Button Content="Уменьшить коэффициенты (--eq)" Command="{Binding DecrementCommand}" Width="210" Height="30" Margin="5"/>
                </StackPanel>
            </GroupBox>

            <!-- Приведение типов -->
            <GroupBox Header="Тест приведений типов" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <TextBlock Text="Неявное (double eq): " FontWeight="Bold"/>
                        <TextBlock Text="{Binding ImplicitDoubleText}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <TextBlock Text="Явное ((bool)eq): " FontWeight="Bold"/>
                        <TextBlock Text="{Binding ExplicitBoolText}"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Сравнение с другим уравнением -->
            <GroupBox Header="Сравнение (операторы == и !=)" Padding="10">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="a2: " VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding InputA2, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,10,0"/>

                        <TextBlock Grid.Column="2" Text="b2: " VerticalAlignment="Center"/>
                        <TextBox Grid.Column="3" Text="{Binding InputB2, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,10,0"/>

                        <TextBlock Grid.Column="4" Text="c2: " VerticalAlignment="Center"/>
                        <TextBox Grid.Column="5" Text="{Binding InputC2, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0"/>
                    </Grid>

                    <Button Content="Сравнить Уравнение 1 и Уравнение 2" Command="{Binding CompareCommand}" Height="30" Margin="0,5"/>

                    <TextBlock Text="{Binding ComparisonResult}" Margin="0,5,0,0" Foreground="DarkBlue" TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</Window>